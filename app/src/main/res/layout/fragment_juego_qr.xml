<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E0F2F1">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/fondo_principal"
        android:scaleType="centerCrop"
        android:alpha="0.3"/>

    <TextView
        android:id="@+id/tvTituloQR"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="BUSCA 5 OBJETOS PARA AYUDAR A SANTA CLAUS"
        android:textSize="26sp"
        android:textAlignment="center"
        android:textStyle="bold"
        android:textColor="#1B5E20"
        android:background="#D9FFFFFF"
        android:padding="16dp"
        android:elevation="4dp"
        android:layout_marginTop="32dp"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvSubtituloQR"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Cada objeto tiene un QR asociado que debes escanear"
        android:textSize="14sp"
        android:textAlignment="center"
        android:textStyle="italic"
        android:textColor="#004D40"
        android:background="#D9FFFFFF"
        android:paddingBottom="16dp"
        android:paddingHorizontal="16dp"
        android:elevation="4dp"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintTop_toBottomOf="@id/tvTituloQR"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintTop_toBottomOf="@id/tvTituloQR"
        app:layout_constraintBottom_toTopOf="@id/buttonSiguiente"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/textViewPista1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:text="🔥 Necesitamos algo para apagar el fuego."
            android:textColor="#00796B"
            android:textSize="17sp"
            android:textStyle="bold"
            android:elevation="3dp" />

        <TextView
            android:id="@+id/textViewPista2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:text="🥤 A Santa no le gusta el agua, prefiere bebidas calientes."
            android:textColor="#00796B"
            android:textSize="17sp"
            android:textStyle="bold"
            android:elevation="3dp" />

        <TextView
            android:id="@+id/textViewPista3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:text="🦯 Necesita algo para apoyarse al caminar. Ya esta mayorcito el pobre."
            android:textColor="#00796B"
            android:textSize="17sp"
            android:textStyle="bold"
            android:elevation="3dp" />

        <TextView
            android:id="@+id/textViewPista4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:text="🛠️ El trineo esta hecho polvo. Haran falta herramientas para arreglarlo."
            android:textColor="#00796B"
            android:textSize="17sp"
            android:textStyle="bold"
            android:elevation="3dp" />

        <TextView
            android:id="@+id/textViewPista5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:text="👓 Santa no ve nada, ¡busca sus gafas!"
            android:textColor="#00796B"
            android:textSize="17sp"
            android:textStyle="bold"
            android:elevation="3dp" />

    </LinearLayout>

    <Button
        android:id="@+id/buttonSiguiente"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nivel Bloqueado 🔒"
        android:textSize="18sp"
        android:backgroundTint="#757575"
        android:textColor="#FFFFFF"
        android:paddingHorizontal="32dp"
        android:paddingVertical="12dp"
        android:enabled="false"
        android:layout_marginBottom="32dp"
        android:elevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>