<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E0F2F1">

    <LinearLayout
        android:id="@+id/panelDecodificador"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#263238"
        android:padding="24dp"
        android:elevation="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📟 DECODIFICADOR v1.0"
            android:textColor="#80CBC4"
            android:textStyle="bold"
            android:layout_gravity="center"/>

        <EditText
            android:id="@+id/etEntradaCifrada"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Introduce código (Ej: XYVVSR)"
            android:textColorHint="#90A4AE"
            android:textColor="#FFFFFF"
            android:backgroundTint="#80CBC4"
            android:layout_marginTop="16dp"/>

        <Button
            android:id="@+id/btnDecodificar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TRADUCIR CÓDIGO"
            android:backgroundTint="#009688"
            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/tvResultadoDecodificado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Resultado: ..."
            android:textColor="#00E676"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="12dp"
            android:background="#10000000"
            android:layout_marginTop="12dp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvPregunta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="SANTA PREGUNTA:\n'¡Joven! En España, ese XYVVSR que coméis de postre... ¿De qué está hecho?'"
        android:textSize="20sp"
        android:gravity="center"
        android:textStyle="italic"
        android:textColor="#D32F2F"
        android:padding="24dp"
        app:layout_constraintTop_toBottomOf="@id/panelDecodificador"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/etRespuestaFinal"/>

    <EditText
        android:id="@+id/etRespuestaFinal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Tu respuesta para Santa..."
        android:textAlignment="center"
        android:layout_marginHorizontal="40dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/btnEnviarRespuesta"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btnEnviarRespuesta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="RESPONDER A SANTA"
        android:backgroundTint="#D32F2F"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>