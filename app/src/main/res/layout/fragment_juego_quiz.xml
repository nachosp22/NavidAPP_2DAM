<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E0F7FA">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/fondo_principal"
        android:scaleType="centerCrop"
        android:alpha="0.3"/>

    <TextView
        android:id="@+id/tvTituloQuiz"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚔️ DUELO FINAL ⚔️"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#B71C1C"
        android:layout_marginTop="32dp"
        android:shadowColor="#FFFFFF"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="2"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvPuntuacion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Puntos: 0"
        android:textSize="20sp"
        android:textColor="#1B5E20"
        android:textStyle="bold"
        android:background="#CCFFFFFF"
        android:padding="8dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvTituloQuiz"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvPregunta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:background="#FFFFFF"
        android:padding="24dp"
        android:elevation="8dp"
        android:text="Cargando pregunta..."
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/tvPuntuacion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:id="@+id/layoutRespuestas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp"
        app:layout_constraintTop_toBottomOf="@id/tvPregunta">

        <Button
            android:id="@+id/btnOp1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Opción 1"
            android:textSize="18sp"
            android:padding="12dp"
            android:backgroundTint="#00695C"
            android:layout_marginBottom="16dp"
            android:elevation="4dp"/>

        <Button
            android:id="@+id/btnOp2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Opción 2"
            android:textSize="18sp"
            android:padding="12dp"
            android:backgroundTint="#00695C"
            android:layout_marginBottom="16dp"
            android:elevation="4dp"/>

        <Button
            android:id="@+id/btnOp3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Opción 3"
            android:textSize="18sp"
            android:padding="12dp"
            android:backgroundTint="#00695C"
            android:layout_marginBottom="16dp"
            android:elevation="4dp"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/panelFinal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone"
        android:elevation="20dp">

        <TextView
            android:id="@+id/tvMensajeFinal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¡FELICIDADES!"
            android:textColor="#FFD700"
            android:textSize="36sp"
            android:textStyle="bold"
            android:gravity="center"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="4"/>

        <TextView
            android:id="@+id/tvSubtituloFinal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Has salvado la Navidad"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:layout_marginTop="24dp"
            android:gravity="center"/>

        <Button
            android:id="@+id/btnSalir"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TERMINAR AVENTURA"
            android:backgroundTint="#D32F2F"
            android:textSize="20sp"
            android:padding="16dp"
            android:layout_marginTop="48dp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>