<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E8F5E9">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/fondo_principal"
        android:scaleType="centerCrop"
        android:alpha="0.3"/>

    <ImageView
        android:id="@+id/imgGrinchFinal"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/angel_sinfondo"
        android:visibility="invisible"
        tools:visibility="visible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="60dp"
        android:layout_marginStart="24dp"/>

    <TextView
        android:id="@+id/tvGrinchFinal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:layout_marginStart="16dp"
        android:background="#C8E6C9"
        android:padding="16dp"
        android:text=""
        tools:text="Texto del Grinch..."
        android:textColor="#1B5E20"
        android:textStyle="bold|italic"
        android:textSize="22sp"
        android:elevation="4dp"
        android:visibility="invisible"
        tools:visibility="visible"
        app:layout_constraintStart_toEndOf="@id/imgGrinchFinal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/imgGrinchFinal"
        app:layout_constraintBottom_toBottomOf="@id/imgGrinchFinal"/>

    <ImageView
        android:id="@+id/imgSantaFinal"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_marginTop="144dp"
        android:layout_marginEnd="16dp"
        android:src="@drawable/mike_sinfondo"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imgGrinchFinal"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tvSantaFinal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginStart="24dp"
        android:background="#FFEBEE"
        android:padding="16dp"
        android:text=""
        tools:text="Texto de Santa..."
        android:textColor="#B71C1C"
        android:textStyle="bold"
        android:textSize="22sp"
        android:elevation="4dp"
        android:visibility="invisible"
        tools:visibility="visible"
        app:layout_constraintEnd_toStartOf="@id/imgSantaFinal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/imgSantaFinal"
        app:layout_constraintBottom_toBottomOf="@id/imgSantaFinal"/>

    <LinearLayout
        android:id="@+id/layoutInfoFinal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:background="#D9FFFFFF"
        android:visibility="invisible"
        tools:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvMensajeInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="\n¡Muchas gracias por participar!\nConsulta tu tiempo en la clasificación"
            android:textAlignment="center"
            android:textColor="#000000"
            android:textSize="24sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnVolverInicio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VOLVER AL INICIO"
            android:textSize="20sp"
            android:backgroundTint="#1B5E20"
            android:textColor="#FFFFFF"
            android:layout_marginTop="24dp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>