<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/fondo_principal"
        android:scaleType="centerCrop"
        android:alpha="0.4"/>

    <TextView
        android:id="@+id/tvSantaDespedida"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:background="#E1F5FE"
        android:padding="20dp"
        android:text=""
        android:textColor="#D32F2F"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="60dp"/>

    <TextView
        android:id="@+id/tvGrinch"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:background="#C8E6C9"
        android:padding="24dp"
        android:text=""
        android:textColor="#1B5E20"
        android:textSize="22sp"
        android:textStyle="bold|italic"
        android:visibility="invisible"
        android:elevation="10dp"
        android:rotation="-2"
        app:layout_constraintTop_toBottomOf="@id/tvSantaDespedida"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="40dp"/>

    <Button
        android:id="@+id/btnDueloGrinch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚔️ ACEPTAR EL RETO"
        android:backgroundTint="#2E7D32"
        android:textColor="#FFFFFF"
        android:padding="16dp"
        android:visibility="invisible"
        android:layout_marginBottom="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>